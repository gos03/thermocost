# Environment variables for Thermocost3
# Copy this file to .env and update with your configuration

# FastAPI
DEBUG=false
LOG_LEVEL=info

# Docker
DOCKER_REGISTRY=
DOCKER_IMAGE=thermocost:latest

# OVH Server (used by GitHub Actions for deployment)
OVH_SSH_KEY=your-private-ssh-key
OVH_HOST=your-server-ip-or-domain
OVH_USER=deployer
