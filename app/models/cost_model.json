{
  "version": "1.0",
  "currency": "EUR",
  "output": "TTC",
  "fields": [
    {
      "id": "type_usage",
      "label": "Type de PAC et usage",
      "type": "select",
      "options": [
        "Air-air (chauffage seul)",
        "Air-air (chauffage + rafraîchissement)",
        "Air-eau (chauffage seul)",
        "Air-eau (chauffage + ECS)",
        "Géothermie (chauffage seul)",
        "Géothermie (chauffage + ECS)"
      ],
      "required": true,
      "weight_hint": "fort"
    },
    {
      "id": "type_logement",
      "label": "Type de logement",
      "type": "select",
      "options": [
        "Maison individuelle",
        "Maison mitoyenne/jumelée",
        "Appartement RDC",
        "Appartement étage",
        "Duplex"
      ],
      "required": true,
      "weight_hint": "moyen"
    },
    {
      "id": "acces_chantier",
      "label": "Accès chantier & emplacement unité extérieure",
      "type": "select",
      "options": [
        "Accès facile (RDC, jardin/cour, proximité véhicule)",
        "Accès moyen (escaliers, cour intérieure, distance moyenne)",
        "Accès difficile (nacelle/toiture/ruelle étroite/longue distance)"
      ],
      "required": true,
      "weight_hint": "moyen"
    },
    {
      "id": "surface",
      "label": "Surface à chauffer (m²)",
      "type": "number",
      "integer": true,
      "min": 20,
      "max": 400,
      "required": true,
      "weight_hint": "fort"
    },
    {
      "id": "isolation",
      "label": "Niveau d’isolation",
      "type": "select",
      "options": [
        "Bonne (RT2012/BBC ou rénové récemment)",
        "Moyenne (années 80–2000, isolation partielle)",
        "Faible (avant 1975, peu ou pas isolé)"
      ],
      "required": true,
      "weight_hint": "fort"
    },
    {
      "id": "emetteurs",
      "label": "Émetteurs existants",
      "type": "select",
      "options": [
        "Radiateurs basse température",
        "Plancher chauffant",
        "Radiateurs haute température / fonte",
        "Ventilo-convecteurs existants",
        "Aucun (à créer)"
      ],
      "required": true,
      "weight_hint": "moyen"
    },
    {
      "id": "climat",
      "label": "Zone climatique",
      "type": "select",
      "options": [
        "Zone froide",
        "Zone tempérée",
        "Zone douce"
      ],
      "required": true,
      "weight_hint": "moyen"
    },
    {
      "id": "pieces_airair",
      "label": "(Si PAC air-air) Nombre de pièces à équiper",
      "type": "number",
      "integer": true,
      "min": 0,
      "max": 20,
      "required": false,
      "weight_hint": "moyen"
    },
    {
      "id": "ecs_inclus",
      "label": "Production d’eau chaude par la PAC",
      "type": "boolean",
      "required": true,
      "weight_hint": "moyen"
    },
    {
      "id": "nb_personnes",
      "label": "Nombre de personnes dans le logement",
      "type": "number",
      "integer": true,
      "min": 1,
      "max": 10,
      "required": true,
      "weight_hint": "moyen"
    }
  ],
  "pricing_model": {
    "base_m2_ht": {
      "Air-air (chauffage seul)": 70,
      "Air-air (chauffage + rafraîchissement)": 75,
      "Air-eau (chauffage seul)": 100,
      "Air-eau (chauffage + ECS)": 110,
      "Géothermie (chauffage seul)": 150,
      "Géothermie (chauffage + ECS)": 160
    },
    "coef_isolation": {
      "Bonne (RT2012/BBC ou rénové récemment)": 0.8,
      "Moyenne (années 80–2000, isolation partielle)": 1.0,
      "Faible (avant 1975, peu ou pas isolé)": 1.2
    },
    "coef_climat": {
      "Zone douce": 0.9,
      "Zone tempérée": 1.0,
      "Zone froide": 1.15
    },
    "coef_logement": {
      "Maison individuelle": 1.0,
      "Maison mitoyenne/jumelée": 1.02,
      "Appartement RDC": 1.05,
      "Appartement étage": 1.10,
      "Duplex": 1.10
    },
    "coef_acces_chantier": {
      "Accès facile (RDC, jardin/cour, proximité véhicule)": 1.0,
      "Accès moyen (escaliers, cour intérieure, distance moyenne)": 1.1,
      "Accès difficile (nacelle/toiture/ruelle étroite/longue distance)": 1.25
    },
    "coef_emetteurs": {
      "Radiateurs basse température": 1.0,
      "Plancher chauffant": 1.0,
      "Ventilo-convecteurs existants": 1.0,
      "Radiateurs haute température / fonte": 1.15,
      "Aucun (à créer)": 1.30
    },
    "airair_pieces": {
      "base_pieces_incluses": 3,
      "increment_coef_par_piece_sup": 0.05,
      "coef_min": 1.0
    },
    "ecs": {
      "enabled_if": "ecs_inclus == true",
      "cout_ecs_ht_base": 800,
      "cout_ecs_ht_par_personne": 250
    },
    "tva": {
      "renovation_eligible": 0.055,
      "standard": 0.20
    },
    "formula": {
      "description": "Calcule un coût estimatif TTC à partir des entrées utilisateur.",
      "steps": [
        "1. base_m2_ht = base_m2_ht[type_usage]",
        "2. coef_iso = coef_isolation[isolation]",
        "3. coef_clim = coef_climat[climat]",
        "4. surface_corr = surface * coef_iso * coef_clim",
        "5. base_ht = surface_corr * base_m2_ht",
        "6. coef_log = coef_logement[type_logement]",
        "7. coef_acces = coef_acces_chantier[acces_chantier]",
        "8. coef_emit = coef_emetteurs[emetteurs]",
        "9. if type_usage contient 'Air-air': coef_airair = 1 + max(pieces_airair - airair_pieces.base_pieces_incluses, 0) * airair_pieces.increment_coef_par_piece_sup; sinon coef_airair = 1",
        "10. cout_ecs_ht = (ecs_inclus ? (ecs.cout_ecs_ht_base + ecs.cout_ecs_ht_par_personne * nb_personnes) : 0)",
        "11. coef_global = coef_log * coef_acces * coef_emit * coef_airair",
        "12. cout_ht = base_ht * coef_global + cout_ecs_ht",
        "13. tva = (conditions renovation energetique remplies ? tva.renovation_eligible : tva.standard)",
        "14. cout_ttc = cout_ht * (1 + tva)"
      ]
    },
    "notes": {
      "usage": "Les coefficients sont calibrés pour donner un ordre de grandeur réaliste. Adapter selon les prix réels des installateurs partenaires.",
      "output_suggestion": "Afficher une fourchette +/- 15% autour du cout_ttc."
    }
  }
}
